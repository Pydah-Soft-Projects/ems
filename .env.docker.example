# Public URLs for the frontend Docker BUILD (required on the EC2 server).
#
#   cp .env.docker.example .env.docker
#   nano .env.docker
#
# Replace YOUR_SERVER_IP with the IP/domain users open in the browser.

NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP/api
NEXT_PUBLIC_APP_URL=http://YOUR_SERVER_IP

# With domain + HTTPS later:
# NEXT_PUBLIC_API_URL=https://ems.yourcollege.edu/api
# NEXT_PUBLIC_APP_URL=https://ems.yourcollege.edu
#
# Match the same origin in backend/.env:
#   CORS_ORIGIN=http://YOUR_SERVER_IP
