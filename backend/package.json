{
  "name": "ems-backend",
  "version": "0.2.0",
  "description": "Examination Management System - Backend (Node.js + Express)",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --import tsx --watch src/index.ts",
    "predev": "kill-port 4000",
    "start": "node dist/index.js",
    "start:dev": "node --import tsx --watch src/index.ts",
    "db:setup": "tsx scripts/create-exam-portal-db.ts",
    "simulate": "tsx scripts/simulate-workflow.ts"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "mysql2": "^3.11.3",
    "razorpay": "^2.9.6",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.4",
    "kill-port": "^2.0.1",
    "mongodb-memory-server": "^10.1.4",
    "sqlite3": "^5.1.7",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
