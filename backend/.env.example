NODE_ENV=development
PORT=4000
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000
# Structured log verbosity: trace, debug, info, warn, error, or fatal
LOG_LEVEL=info

JWT_SECRET=change-me-in-prod-super-secret
JWT_EXPIRES_IN=1d

# ─────────────────────────────────────────────────────────────
# HRMS MongoDB — Super Admin authentication ONLY
# ─────────────────────────────────────────────────────────────
HRMS_MONGODB_URI=mongodb://user:password@host:27017/hrms?authSource=admin
HRMS_USERS_COLLECTION=users
HRMS_SUPER_ADMIN_ROLE=super_admin

# ─────────────────────────────────────────────────────────────
# Fee Management MongoDB — post exam-fee collections as Transactions
# Place your Fee Management connection string here (separate from HRMS)
# ─────────────────────────────────────────────────────────────
FEE_MANAGEMENT_MONGODB_URI=
FEE_MANAGEMENT_EXAM_FEE_HEAD_CODE=EXM01

# ─────────────────────────────────────────────────────────────
# Exam Portal MySQL — EMS primary database (same RDS cluster)
# Stores: regulations, subjects, exams, fees, payments
# Create DB first: npm run db:setup
# ─────────────────────────────────────────────────────────────
EXAM_PORTAL_DB_HOST=student-database.cfu0qmo26gh3.ap-south-1.rds.amazonaws.com
EXAM_PORTAL_DB_PORT=3306
EXAM_PORTAL_DB_NAME=examination_portal
EXAM_PORTAL_DB_USER=admin
EXAM_PORTAL_DB_PASSWORD=
EXAM_PORTAL_DB_SSL=true
EXAM_PORTAL_DB_SYNCHRONIZE=true

# RDS SSL: leave false unless you bundle the AWS RDS CA PEM (MYSQL_SSL_CA_PATH)
MYSQL_SSL_REJECT_UNAUTHORIZED=false
# MYSQL_SSL_CA_PATH=./certs/rds-combined-ca-bundle.pem

# ─────────────────────────────────────────────────────────────
# Student MySQL — existing student master database (same cluster)
# Read-only for now; SDMS / student integration comes later
# ─────────────────────────────────────────────────────────────
STUDENT_DB_HOST=student-database.cfu0qmo26gh3.ap-south-1.rds.amazonaws.com
STUDENT_DB_PORT=3306
STUDENT_DB_NAME=student_database
#STUDENT_DB_NAME=student_database_testing
STUDENT_DB_USER=admin
STUDENT_DB_PASSWORD=
STUDENT_DB_SSL=true

# ─────────────────────────────────────────────────────────────
# Razorpay (optional env fallback — prefer Dashboard → Settings)
# ─────────────────────────────────────────────────────────────
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=
# (Webhook not required — payments verify via Checkout popup on the fee page)
